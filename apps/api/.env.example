APP_NAME=app-api
APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase (server-side: service_role is backend-only, never expose to web)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# OpenAI (optional — remove if the project has no AI features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
